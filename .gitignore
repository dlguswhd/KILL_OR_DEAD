# ============================================
# Unity — 자동 생성 폴더 (절대 올리지 말 것)
# ============================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store 도구가 만드는 폴더
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# ============================================
# Visual Studio / Rider / VS Code — 자동 생성
# ============================================
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ============================================
# 빌드 결과물
# ============================================
*.apk
*.aab
*.unitypackage
*.app
ExportedObj/
.consulo/
crashlytics-build.properties

# ============================================
# 압축 파일 — 이미 임포트했으면 저장소에 넣을 이유가 없다
# (shooting-range.zip 등 합쳐서 190MB 가까이 됨)
# ============================================
/[Aa]ssets/**/*.zip
/[Aa]ssets/**/*.rar
/[Aa]ssets/**/*.7z
/[Aa]ssets/**/*.zip.meta
/[Aa]ssets/**/*.rar.meta
/[Aa]ssets/**/*.7z.meta

# ============================================
# OS 자동 생성 (macOS / Windows)
# ============================================
.DS_Store
.AppleDouble
.LSOverride
._*
.fseventsd/
.Spotlight-V100/
.Trashes/
.TemporaryItems/
.DocumentRevisions-V100/
Thumbs.db
desktop.ini

# ============================================
# Unity 크래시 리포트
# ============================================
sysinfo.txt
*.stackdump

# ============================================
# Claude Code / AI 도구 — 개인 파일, 저장소 제외
# ============================================
/CLAUDE.md
/claude/
/.claude/
/.mcp.json

# ============================================
# opencode — 로컬 파일
# ============================================
/.opencode/
/AGENTS.md
/opencode.json
/opencode.jsonc

# ============================================
# unitypackage 짝 없는 meta
# 본체(*.unitypackage)는 위에서 무시되는데 Unity가 만드는 .meta 는 안 걸려서,
# 가리킬 대상이 없는 빈 껍데기 meta 만 계속 커밋 목록에 뜬다.
# ============================================
*.unitypackage.meta
*.pdb.meta
*.mdb.meta
*.pidb.meta

# ============================================
# 작업 중 생긴 산출물 / 스크린샷 — 저장소에 넣을 이유 없음
# ============================================
/Claude outputs/
/화면 캡처*.png
/Screenshot*.png

# ============================================
# 협업 스킬 — 아래 5종만 저장소에 공유하고, 그 외 로컬 스킬은 무시
# ============================================
/.agents/skills/*
!/.agents/skills/commit/
!/.agents/skills/git-workflow/
!/.agents/skills/issue-create/
!/.agents/skills/branch-create/
!/.agents/skills/pr-create/
