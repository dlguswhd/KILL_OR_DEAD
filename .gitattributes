# ============================================
# 기본 — 줄바꿈 자동 정규화
# ============================================
* text=auto

# ============================================
# Unity 파일은 텍스트로 취급 + 병합 시 충돌 표시
# (프로젝트가 이미 Force Text 모드라 가능하다)
# ============================================
*.cs        text diff=csharp
*.shader    text
*.cginc     text
*.hlsl      text
*.md        text
*.json      text
*.txt       text

*.unity     -text merge=unityyamlmerge diff
*.prefab    -text merge=unityyamlmerge diff
*.asset     -text merge=unityyamlmerge diff
*.mat       -text merge=unityyamlmerge diff
*.anim      -text merge=unityyamlmerge diff
*.controller -text merge=unityyamlmerge diff
*.mask      -text merge=unityyamlmerge diff
*.physicMaterial -text merge=unityyamlmerge diff
*.meta      -text merge=unityyamlmerge diff

# ============================================
# Git LFS — 큰 바이너리 파일
# 반드시 "첫 커밋 전"에 설정되어 있어야 한다
#
# 대소문자 양쪽 패턴을 모두 둔다.
# gitattributes 패턴 매칭은 core.ignorecase 를 따르는데,
# 이 값은 파일시스템의 대소문자 구분 여부로 자동 결정된다.
# 따라서 대소문자 구분 파일시스템(리눅스, Docker, CI 등)에서는
# "*.fbx" 가 "*.FBX" 에 매칭되지 않아 LFS 누락이 발생한다.
# ============================================
*.fbx    filter=lfs diff=lfs merge=lfs -text
*.FBX    filter=lfs diff=lfs merge=lfs -text
*.blend  filter=lfs diff=lfs merge=lfs -text
*.BLEND  filter=lfs diff=lfs merge=lfs -text
*.obj    filter=lfs diff=lfs merge=lfs -text
*.OBJ    filter=lfs diff=lfs merge=lfs -text
